{
  "name": "cognitive-interval-timer",
  "version": "1.1.0",
  "private": true,
  "description": "Client-side cognitive interval timer with phase-based workflow.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:pages": "node scripts/build-pages.js _site",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:pwa:offline": "node tests/pwa-offline-smoke.js",
    "test:pages:artifact": "node tests/pages-artifact-smoke.js",
    "validate": "node scripts/validate.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "prettier": "^3.5.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/patrickjohnson3/cognitive-interval-timer.git"
  },
  "homepage": "https://patrickjohnson3.github.io/cognitive-interval-timer/",
  "bugs": {
    "url": "https://github.com/patrickjohnson3/cognitive-interval-timer/issues"
  }
